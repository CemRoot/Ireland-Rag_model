# ============================================
# Ireland RAG - Environment Variables
# ============================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# cp .env.example .env

# ============================================
# 🔑 LlamaCloud API Key (PDF → Markdown dönüşümü için)
# ============================================
# API key almak için: https://cloud.llamaindex.ai/api-key
# Ücretsiz: 1,000 sayfa/gün
LLAMA_CLOUD_API_KEY=llx-YOUR_API_KEY_HERE

# ============================================
# 🌲 Pinecone (Vector Database)
# ============================================
# Dashboard: https://app.pinecone.io
PINECONE_API_KEY=pcsk_YOUR_KEY_HERE
PINECONE_INDEX=dublin-ai-assistant
PINECONE_HOST=dublin-ai-assistant-xxx.svc.aped-xxx.pinecone.io

# ============================================
# 🤖 OpenAI (Embedding & Chat) - Opsiyonel
# ============================================
# Sadece n8n dışında kullanacaksanız gerekli
# n8n kendi OpenAI kredisini kullanıyor
OPENAI_API_KEY=sk-YOUR_KEY_HERE

